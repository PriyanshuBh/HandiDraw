generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"

}


model User {
  id                String    @id @default(uuid())
  password          String?
  email             String    @unique
  name              String?
  photo             String?
  shapes            Shape[]   
  rooms             Room[]   
  authType          AuthType  
  isEmailVerified   Boolean   @default(false)
  ownedRooms        Room[]    @relation("RoomAdmin")    
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordResetTokens PasswordResetToken[] // Added for relation back to PasswordResetToken
}

model Room {
  id          String    @id @default(uuid())
  slug        String?    @unique
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminId     String
  admin       User      @relation("RoomAdmin", fields: [adminId], references: [id])
  users       User[]    
  shapes      Shape[]   
  // isPublic    Boolean   @default(true)
  // canvasWidth  Int      @default(1920)
  // canvasHeight Int      @default(1080)
}

model Shape {
  id          String    @id @default(uuid())
  type        ShapeType 
  x           Float     
  y           Float     
  width       Float?    
  height      Float?    
  radiusX     Float?    
  radiusY     Float?
  points      Json?     
  color       String? 
  strokeWidth Float?     @default(1)
  fontSize    Float?     @default(24)
  textContent String?
  fill        Boolean?   @default(true)
  zIndex      Int?       @default(0)
  userId      String    
  roomId      String    
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OTP {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Store hashed token here
  expiresAt DateTime
  createdAt DateTime @default(now())
}


enum ShapeType {
  RECTANGLE 
  CIRCLE
  LINE
  ARROW
  PENCIL
  TEXT
  ERASER
  DIAMOND // Added DIAMOND
}

enum AuthType {
  GOOGLE
  CREDENTIALS
}